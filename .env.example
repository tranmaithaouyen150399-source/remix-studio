# Khóa Claude API (https://platform.claude.com) — để AI viết kịch bản và xem khung hình
ANTHROPIC_API_KEY=
# Khóa Google Cloud (đã bật Cloud Text-to-Speech API) — để có giọng đọc AI
GOOGLE_TTS_API_KEY=
# Mật khẩu vào trang. Để trống thì ai có link cũng dùng được (và tiêu tiền API của bạn)
APP_PASSWORD=
# Model Claude, mặc định claude-opus-5-5
CLAUDE_MODEL=claude-opus-5-5
PORT=3000
